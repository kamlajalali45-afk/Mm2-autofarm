local function raidPlayerBase()
    statusLabel.Text = "Scanning rival player bases..."
    
    -- Look for the server's plots folder where player bases are instantiated
    local plotsFolder = Workspace:FindFirstChild("Plots") or Workspace:FindFirstChild("PlayerPlots") or Workspace:FindFirstChild("Bases")
    
    if not plotsFolder then
        -- Fallback: search workspace for objects owned by other players
        statusLabel.Text = "Searching all base structures..."
    end
    
    local targetPrompt = nil
    local targetPart = nil
    
    -- Scan through plots or find prompts belonging to other player setups
    local searchContainer = plotsFolder or Workspace
    for _, descendant in ipairs(searchContainer:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled then
            local fullName = descendant:GetFullName():lower()
            -- Ensure it's part of a base/podium and not an old static map prop
            if not string.find(fullName, "candy") and not string.find(fullName, "shop") then
                -- Check if parent belongs to another player's base area
                targetPrompt = descendant
                targetPart = descendant.Parent
                break
            end
        end
    end
    
    if targetPrompt and targetPart then
        statusLabel.Text = "Base located! Raiding..."
        local char = localPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local destCF = targetPart:IsA("BasePart") and targetPart.CFrame or hrp.CFrame
            
            -- Smooth tween straight into their base
            local tween = TweenService:Create(hrp, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {CFrame = destCF + Vector3.new(0, 3, 0)})
            tween:Play()
            
            local finished = false
            task.delay(0.5, function() finished = true end)
            repeat task.wait() until tween.PlaybackState == Enum.PlaybackState.Completed or finished
            
            task.wait(0.1)
            statusLabel.Text = "Snatching from base!"
            fireproximityprompt(targetPrompt)
            task.wait(0.2)
            statusLabel.Text = "Raid complete!"
        end
    else
        statusLabel.Text = "No active base items found."
    end
end

tpBaseBtn.MouseButton1Click:Connect(function()
    pcall(raidPlayerBase)
end)

print("Base Snatcher Loaded.")
