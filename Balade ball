makeDraggable(floatingFrame)

-- Find Active Ball Helper
local function getActiveBall()
    local workspaceFolder = Workspace:FindFirstChild("Balls") or Workspace
    for _, obj in ipairs(workspaceFolder:GetChildren()) do
        if obj:IsA("BasePart") and (obj.Name == "Ball" or obj.Name:lower():find("ball")) then
            return obj
        end
    end
    -- Fallback search recursive if not in direct folder
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == "Ball" and obj:FindFirstChild("ZoomVisualizer") or (obj.AssemblyLinearVelocity.Magnitude > 5) then
            return obj
        end
    end
    return nil
end

-- Trigger Parry Action (Simulates pressing 'F' or clicking to parry)
local function triggerParry()
    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    task.wait(0.02)
    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

-- Visualizer Highlight for the Ball
local ballHighlight = Instance.new("Highlight")
ballHighlight.FillColor = Color3.fromRGB(0, 255, 150)
ballHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)

RunService.RenderStepped:Connect(function()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local ball = getActiveBall()
    
    -- Visualizer Logic
    if isVisualizerActive and ball then
        ballHighlight.Adornee = ball
        ballHighlight.Parent = ball
    else
        ballHighlight.Parent = nil
    end
    
    -- Auto Parry Core Loop
    if isAutoParryActive and ball then
        local hrp = char.HumanoidRootPart
        local distance = (hrp.Position - ball.Position).Magnitude
        
        -- Check if ball is targeting the local player (moving towards us)
        local toPlayer = (hrp.Position - ball.Position).Unit
        local ballVelocity = ball.AssemblyLinearVelocity
        
        if ballVelocity.Magnitude > 0 then
            local dotProduct = ballVelocity.Unit:Dot(toPlayer)
            -- If ball is heading toward player and within distance threshold
            if dotProduct > 0.3 and distance <= parryDistance then
                triggerParry()
                task.wait(0.15) -- Cooldown to prevent spamming
            end
        end
    end
end)

