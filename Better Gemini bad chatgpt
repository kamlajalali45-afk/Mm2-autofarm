local function safeStealRoutine()
    statusLabel.Text = "Searching for items..."
    
    -- Universal search: look for ProximityPrompts or TouchInterests anywhere in workspace maps/plots
    local targetPrompt = nil
    local targetPart = nil
    
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            -- Make sure it's not our own or part of shop UI
            targetPrompt = obj
            targetPart = obj.Parent
            break
        end
    end
    
    if targetPrompt and targetPart then
        statusLabel.Text = "Target found! Moving..."
        local char = localPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local hrp = char.HumanoidRootPart
            local destCF = targetPart:IsA("BasePart") and targetPart.CFrame or hrp.CFrame
            
            -- Fast safety tween with a strict timeout so it never freezes
            local tween = TweenService:Create(hrp, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {CFrame = destCF + Vector3.new(0, 3, 0)})
            tween:Play()
            
            -- Wait for tween with timeout safety
            local finished = false
            task.delay(0.5, function() finished = true end)
            repeat task.wait() until tween.PlaybackState == Enum.PlaybackState.Completed or finished
            
            task.wait(0.1)
            statusLabel.Text = "Stealing..."
            fireproximityprompt(targetPrompt)
            task.wait(0.2)
            statusLabel.Text = "Done!"
        end
    else
        statusLabel.Text = "No active prompts found!"
    end
end

tpBestBtn.MouseButton1Click:Connect(function()
    pcall(safeStealRoutine)
end)

