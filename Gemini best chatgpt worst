    end
end)

-- Action: Bring Gun to Me Safely
local function executeGetGun()
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local gunDrop = Workspace:FindFirstChild("GunDrop", true)
        if gunDrop then
            if gunDrop:IsA("BasePart") then
                gunDrop.CFrame = char.HumanoidRootPart.CFrame
            elseif gunDrop:IsA("Model") and gunDrop.PrimaryPart then
                gunDrop:SetPrimaryPartCFrame(char.HumanoidRootPart.CFrame)
            end
        end
    end
end

-- Action: Shoot Murderer
local function executeShootMurderer()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    local murdChar = getMurderer()
    if murdChar and murdChar:FindFirstChild("HumanoidRootPart") then
        local gun = char:FindFirstChild("Gun") or localPlayer.Backpack:FindFirstChild("Gun")
        if gun then
            if gun.Parent == localPlayer.Backpack and char:FindFirstChildOfClass("Humanoid") then
                char.Humanoid:EquipTool(gun)
                task.wait(0.1)
            end
            
            local targetPos = murdChar.HumanoidRootPart.Position
            char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, Vector3.new(targetPos.X, char.HumanoidRootPart.Position.Y, targetPos.Z))
            
            if gun:FindFirstChild("Shoot") and gun.Shoot:IsA("RemoteEvent") then
                gun.Shoot:FireServer(targetPos, "Mouse")
            elseif gun:FindFirstChild("RemoteFunction") then
                gun.RemoteFunction:InvokeServer(targetPos)
            else
                gun:Activate()
            end
        end
    end
end

-- Safe Autofarm with Stances & Custom Speed
local SAFE_DISTANCE = 25

local function collectItems()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") or char.Humanoid.Health <= 0 then return end
    
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if not isAutofarming then break end
        
        local murdChar = getMurderer()
        if murdChar and murdChar:FindFirstChild("HumanoidRootPart") then
            local distToMurd = (char.HumanoidRootPart.Position - murdChar.HumanoidRootPart.Position).Magnitude
            if distToMurd < SAFE_DISTANCE then
                task.wait(1)
                continue
            end
        end
        
        if desc:IsA("BasePart") and desc:FindFirstChildOfClass("TouchTransmitter") then
            local pName = desc.Name:lower()
            local parentName = desc.Parent and desc.Parent.Name:lower() or ""
            
            if pName:find("coin") or pName:find("candy") or parentName:find("coin") or parentName:find("candy") then
                if desc.Parent and desc:IsDescendantOf(Workspace) then
                    local targetCFrame = desc.CFrame
                    
                    if currentStance == "Lay" then
                        targetCFrame = targetCFrame * CFrame.Angles(math.rad(90), 0, 0) + Vector3.new(0, -2, 0)
                    elseif currentStance == "Safe" then
                        targetCFrame = targetCFrame - Vector3.new(0, 15, 0)
                    end
                    
                    local dist = (char.HumanoidRootPart.Position - targetCFrame.Position).Magnitude
                    local tweenTime = dist / customSpeed
                    
                    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
                    local tween = TweenService:Create(char.HumanoidRootPart, tweenInfo, {CFrame = targetCFrame})
                    
                    tween:Play()
                    tween.Completed:Wait()
                    task.wait(0.05)
                end
            end
        end
    end
end

