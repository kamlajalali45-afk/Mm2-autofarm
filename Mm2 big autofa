-- 3. ESP Full-Body Role Detection Logic
local function getPlayerRole(player)
    local character = player.Character
    if not character then return "Innocent" end
    
    -- Check tools in Backpack or Character for Sheriff/Murderer identification
    local backpack = player:FindFirstChild("Backpack")
    
    local function hasTool(container)
        if not container then return false end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                if item.Name == "Knife" then
                    return "Murderer"
                elseif item.Name == "Gun" then
                    return "Sheriff"
                end
            end
        end
        return false
    end
    
    local role = hasTool(character) or hasTool(backpack)
    if role then return role end
    
    -- If character has a Hero gun (dropped or carried)
    return "Innocent"
end

local function updateESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local char = player.Character
            local highlight = espHighlights[player]
            
            if isEspActive then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Adornee = char
                    highlight.Parent = char
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    espHighlights[player] = highlight
                else
                    highlight.Adornee = char
                end
                
                -- Determine Role & Assign Color
                local backpack = player:FindFirstChild("Backpack")
                local role = "Innocent"
                
                local function scanContainer(c)
                    if not c then return end
                    for _, item in ipairs(c:GetChildren()) do
                        if item:IsA("Tool") then
                            if item.Name == "Knife" then return "Murderer"
                            elseif item.Name == "Gun" then return "Sheriff" end
                        end
                    end
                end
                
                if scanContainer(char) == "Murderer" or scanContainer(backpack) == "Murderer" then
                    role = "Murderer"
                elseif scanContainer(char) == "Sheriff" or scanContainer(backpack) == "Sheriff" then
                    role = "Sheriff"
                end
                
                if role == "Murderer" then
                    highlight.FillColor = Color3.fromRGB(255, 0, 0)     -- Red
                    highlight.OutlineColor = Color3.fromRGB(200, 0, 0)
                elseif role == "Sheriff" then
                    highlight.FillColor = Color3.fromRGB(0, 120, 255)   -- Blue
                    highlight.OutlineColor = Color3.fromRGB(0, 80, 200)
                else
                    highlight.FillColor = Color3.fromRGB(0, 255, 0)     -- Green
                    highlight.OutlineColor = Color3.fromRGB(0, 200, 0)
                end
            else
                if highlight then
                    highlight:Destroy()
                    espHighlights[player] = nil
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if isEspActive then
        updateESP()
    end
end)

-- 4. Feature Actions (Get Gun & Shoot)
local function executeGetGun()
    local char = localPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local gunDrop = workspace:FindFirstChild("GunDrop", true)
        if gunDrop then
            char.HumanoidRootPart.CFrame = gunDrop.CFrame
        end
    end
end

local function executeShootMurderer()
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer then
            local backpack = player:FindFirstChild("Backpack")
            local pChar = player.Character
            
            local function isMurd(container)
                if not container then return false end
                for _, item in ipairs(container:GetChildren()) do
                    if item.Name == "Knife" then return true end
                end
                return false
            end
            
            if isMurd(pChar) or isMurd(backpack) then
                if pChar and pChar:FindFirstChild("HumanoidRootPart") then
                    -- Position behind or look at murderer if holding a gun tool
                    local gun = char:FindFirstChild("Gun") or localPlayer.Backpack:FindFirstChild("Gun")
                    if gun then
                        char.Humanoid:EquipTool(gun)
                        task.wait(0.1)
                        if gun:FindFirstChild("RemoteFunction") then
                            -- Standard MM2 gun firing simulation
                            gun.RemoteFunction:InvokeServer(pChar.HumanoidRootPart.Position)
                        end
                    end
                end
            end
        end
    end
end

