-- GUI Logic: Dragging
titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        state.dragging = true
        state.dragStart = input.Position
    end
end)

titleBar.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        state.dragging = false
    end
end)

gui.InputBegan:Connect(function(input)
    if state.dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local x = input.Position.X - state.dragStart.X
        local y = input.Position.Y - state.dragStart.Y
        frame.Position = UDim2.fromOffset(state.guiPos.Offset.X + x, state.guiPos.Offset.Y + y)
    end
end)

-- Shrink Logic
shrinkBtn.MouseButton1Click:Connect(function()
    state.guiOpen = not state.guiOpen
