        content.Size = UDim2.new(1, -10, 1, -40)
        frame.Size = UDim2.new(0, 250, 0, 350)
        shrinkBtn.Text = "[-]"
    else
        content.Size = UDim2.new(1, -10, 0, 0)
        frame.Size = UDim2.new(0, 250, 0, 30)
        shrinkBtn.Text = "[+]"
    end
end)

-- Core Logic Functions
local function getEquippedWeapon()
    local tool = character:FindFirstChildWhichIsA("Tool")
    return tool
end

local function findClosestEnemy()
    local closest = nil
    local closestDist = math.huge
    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = other.Character:FindFirstChild("HumanoidRootPart")
            local dist = (hrp.Position - rootPart.Position).Magnitude
            if dist < closestDist and dist < 100 then
                closest = other
                closestDist = dist
            end
        end
    end
    return closest
end

local function autoEquipBest()
    local backpack = player:WaitForChild("Backpack")
    local bestTool = nil
    local bestTier = 0
    
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            local tier = item:GetAttribute("Tier") or 1
            if tier > bestTier then
                bestTier = tier
                bestTool = item
            end
        end
    end
    
    if bestTool and getEquippedWeapon() ~= bestTool then
        player:SelectTool(bestTool)
        print(("[MM2] Auto-equipped %s (Tier %d)"):format(bestTool.Name, bestTier))
    end
end

local function autoLoot()
    for _, part in ipairs(workspace:GetChildren()) do
        if part:IsA("BasePart") and part:GetAttribute("Lootable") then
            if (part.Position - rootPart.Position).Magnitude < 15 then
                -- Simulate picking up (MM2 uses specific methods, but this triggers proximity)
                part:BreakJoints()
                -- In MM2, usually just being near it or touching it works. 
                -- We can force a touch event if needed, but proximity is standard.
            end
        end
    end
end

local function autoChat()
    local lastChat = 0
    return function()
        if os.clock() - lastChat > 30 then
            local features = {}
            for k, v in pairs(state) do
                if type(v) == "boolean" and v and k ~= "guiOpen" and k ~= "dragging" then
                    table.insert(features, k)
                end
            end
            local msg = table.concat(features, ", ")
            player:Chat("[DeepHat] Active: " .. (msg or "None"))
            lastChat = os.clock()
        end
    end
end

