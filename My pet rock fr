-- Dragging Mechanics
local function makeDraggable(frame)
    local dragging, dragInput, dragStart, startPos
    
    frame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

makeDraggable(mainFrame)
makeDraggable(floatingFrame)

-- Function to find and scale the player's pet rock globally in the server workspace
local function setPetRockSize(multiplier)
    pcall(function()
        for _, obj in ipairs(Workspace:GetDescendants()) do
            -- Look for parts or models associated with your user name or labeled as pet rock
            if obj.Name:lower():find("rock") or obj.Name:lower():find("pet") then
                if obj:IsA("BasePart") and obj.Parent and (obj.Parent.Name == localPlayer.Name or obj:IsDescendantOf(localPlayer.Character or workspace)) then
                    obj.Size = obj.Size * multiplier
                elseif obj:IsA("Model") and obj.Name:lower():find("rock") then
                    local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if primary then
                        obj:ScaleTo(multiplier)
                    end
                end
            end
        end
    end)
end

