-- Safe Movement Function (Smooth Tween instead of harsh snap)
local function smoothMoveTo(targetCFrame)
    local char = localPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    -- Calculate distance to adjust speed naturally
    local dist = (hrp.Position - targetCFrame.Position).Magnitude
    local travelTime = math.clamp(dist / 350, 0.1, 0.6) -- Scales speed based on distance
    
    local tweenInfo = TweenInfo.new(travelTime, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    
    tween:Play()
    tween.Completed:Wait()
end

local function safeStealRoutine()
    statusLabel.Text = "Scanning plots safely..."
    task.wait(0.1) -- Anti-spam delay
    
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then
        statusLabel.Text = "Error: Plots folder missing."
        return
    end
    
    local bestPodium = nil
    local maxVal = -1
    local targetPrompt = nil
    
    for _, plot in ipairs(plots:GetChildren()) do
        local owner = plot:GetAttribute("Owner")
        if owner ~= localPlayer.Name then
            local brainrotsFolder = plot:FindFirstChild("Brainrots") or plot
            for _, podium in ipairs(brainrotsFolder:GetChildren()) do
                local valAttr = podium:GetAttribute("Generation") or podium:GetAttribute("Value") or 1
                if valAttr > maxVal then
                    local prompt = podium:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt then
                        maxVal = valAttr
                        bestPodium = podium
                        targetPrompt = prompt
                    end
                end
            end
        end
    end
    
    if bestPodium and targetPrompt then
        statusLabel.Text = "Moving smoothly to target..."
        local targetCF = bestPodium.PrimaryPart and bestPodium.PrimaryPart.CFrame or bestPodium:GetPivot()
        
        -- Offset slightly above/beside to prevent clipping bugs
        smoothMoveTo(targetCF + Vector3.new(0, 3, 0))
        
        -- Human-like reaction delay before interacting
        task.wait(0.2)
        
        statusLabel.Text = "Stealing asset..."
        fireproximityprompt(targetPrompt)
        
        task.wait(0.3)
        statusLabel.Text = "Done! Action complete."
    else
        statusLabel.Text = "No valid targets found."
    end
end

tpBestBtn.MouseButton1Click:Connect(function()
